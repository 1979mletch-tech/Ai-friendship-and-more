# Local Chat is browser-only. Cloud chat requires Supabase and deployed Edge Functions.
# Never put an OpenAI secret or Stripe secret in a VITE_ variable: Vite embeds it in browser code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Billing foundation (preview-safe if omitted)
# Supported values: none | stripe
VITE_BILLING_PROVIDER=none

# Stripe publishable key + price IDs (required only when billing provider is stripe)
VITE_STRIPE_PUBLIC_KEY=
VITE_STRIPE_PRICE_PRO_MONTHLY=
VITE_STRIPE_PRICE_PRO_ANNUAL=
