# AI Friendship environment template
# Never put private AI-provider keys in VITE_* variables: Vite exposes them to the browser.
# Production AI calls must go through an authenticated server/edge endpoint.

# Optional public Supabase browser configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional authenticated server/edge chat endpoint. Leave blank for local demo replies.
VITE_CHAT_API_URL=
VITE_PUBLIC_LIVE_MODE=false
VITE_AGE_VERIFICATION_ENABLED=false

# Billing foundation (preview-safe if omitted)
# Supported values: none | stripe
VITE_BILLING_PROVIDER=none

# Stripe publishable key + price IDs only. Never put Stripe secret keys here.
VITE_STRIPE_PUBLIC_KEY=
VITE_STRIPE_PRICE_PRO_MONTHLY=
VITE_STRIPE_PRICE_PRO_ANNUAL=

# Optional AI-generated Aurora voice; requires the speak Edge Function, an
# OPENAI_API_KEY server secret, ALLOWED_ORIGIN, and server-verified adult users.
VITE_AURORA_SPEECH_ENABLED=false
