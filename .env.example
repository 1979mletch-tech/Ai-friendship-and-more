# Server-backed app boundary. Leave local-preview until a trusted backend is deployed.
VITE_AUTH_MODE=local-preview
VITE_API_BASE_URL=

# AI provider credentials (optional for local/demo)
VITE_OPENAI_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Billing foundation (preview-safe if omitted)
# Supported values: none | stripe
VITE_BILLING_PROVIDER=none

# Stripe publishable key + price IDs (required only when billing provider is stripe)
VITE_STRIPE_PUBLIC_KEY=
VITE_STRIPE_PRICE_PRO_MONTHLY=
VITE_STRIPE_PRICE_PRO_ANNUAL=
